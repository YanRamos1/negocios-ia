---
import { base, home, url } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, noindex = false, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').toString();

const rota = Astro.url.pathname.replace(base, '').replace(/^\/|\/$/g, '');
const chave = rota.split('/')[0];
const comOg = new Set([
  'clt-pj',
  'custo-importacao',
  'rescisao',
  'precificacao-mei',
  'taxa-marketplace',
  'planilha-financeiro',
  'planilha-confeitaria',
  'kit-financeiro',
  'sobre',
  'privacidade',
]);
const imagemRelativa = ogImage ?? (comOg.has(chave) ? `og/${chave}.png` : 'og/default.png');
const imagemAbsoluta = new URL(url(imagemRelativa), Astro.site ?? 'http://localhost:4321').toString();
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <a class="marca" href={home}>calculadoras<span>.br</span></a>
      <nav aria-label="Principal">
        <a href={url('clt-pj/')} aria-current={Astro.url.pathname.includes('clt-pj') ? 'page' : undefined}>CLT x PJ</a>
        <a href={url('custo-importacao/')} aria-current={Astro.url.pathname.includes('custo-importacao') ? 'page' : undefined}>Importação</a>
        <a href={url('rescisao/')} aria-current={Astro.url.pathname.includes('rescisao') ? 'page' : undefined}>Rescisão</a>
        <a href={url('sobre/')} aria-current={Astro.url.pathname.includes('sobre') ? 'page' : undefined}>Sobre</a>
      </nav>
    </header>

    <main class="wrap" id="conteudo" tabindex="-1">
      <slot />
    </main>

    <footer class="rodape">
      <p>
        Conteúdo informativo. Não substitui contador ou advogado.
        Parâmetros vigentes em 2026.
      </p>
      <p>
        <a href={url('privacidade/')}>Privacidade</a> ·
        <a href={url('sobre/')}>Sobre</a>
      </p>
    </footer>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import { url } from '../lib/urls';
import { autor } from '../config/autor';
import { prova } from '../config/prova';

const categorias = [
  {
    titulo: 'Isolamento de dados',
    texto:
      'Consultas de listagem, busca, agregação e exportação que não filtram pelo usuário ou tenant. Em Supabase, RLS ausente; em API própria, filtro que falta no handler.',
  },
  {
    titulo: 'Permissão no servidor',
    texto:
      'Cruzamos cada gate de papel do frontend (isAdmin, canEdit, role) com o endpoint correspondente e verificamos se o backend valida o privilégio.',
  },
  {
    titulo: 'IDOR',
    texto:
      'Percorremos todos os handlers que recebem ID por path, query ou body — não amostras — para verificar posse do objeto.',
  },
  {
    titulo: 'Segredos expostos',
    texto:
      'Código, compose, charts, CI, scripts, documentação, histórico git e bundle do frontend. Inclui defaults públicos como ${VAR:-valor} sem validação de startup.',
  },
  {
    titulo: 'XSS e injeção de HTML',
    texto:
      'innerHTML e equivalentes, markdown sem sanitização, URL de usuário em href/src, eval, e templates de e-mail sem escape no backend.',
  },
];

const entregaveis = [
  ['Relatório em PDF', 'Capa, resumo executivo com gráficos, tabela de achados e recomendações priorizadas.'],
  ['Achado com linha', 'Arquivo:linha, trecho de código, por que é explorável, impacto e correção.'],
  ['Pontos fortes', 'O que foi verificado e está correto — a prova de cobertura da auditoria.'],
  ['Issues prontas', 'Texto completo de cada issue em Markdown, com critérios de aceite verificáveis.'],
];

const passos = [
  ['Escopo', 'Definimos repositório, branch, ambientes e autorização por escrito.'],
  ['Auditoria', 'Leitura do código real, categoria por categoria, adaptada à stack detectada.'],
  ['Entrega', 'PDF, issues e sessão de leitura com o time técnico.'],
];

const selos = [
  'Evidência linha a linha',
  'Escopo assinado',
  'NDA quando necessário',
  'Sem teste em produção',
  'Achado crítico em 24h',
];

const referencias = [
  [
    'OWASP Top 10 (2021)',
    'Riscos de aplicação usados como base das categorias 2, 3 e 5.',
    'https://owasp.org/Top10/',
  ],
  [
    'OWASP ASVS 4.0.3',
    'Verificação de autenticação, autorização, sessão e validação de entrada.',
    'https://owasp.org/www-project-application-security-verification-standard/',
  ],
  [
    'OWASP Top 10 para LLM',
    'Prompt injection, vazamento de dado sensível e uso excessivo de agência.',
    'https://genai.owasp.org/llm-top-10/',
  ],
  [
    'CWE Top 25',
    'Classificação das fraquezas de software mais perigosas.',
    'https://cwe.mitre.org/top25/',
  ],
  [
    'LGPD, arts. 46 a 48',
    'Segurança, sigilo e comunicação de incidente.',
    'https://www.planalto.gov.br/ccivil_03/_ato2015-2018/2018/lei/l13709.htm',
  ],
];

const faq = [
  {
    pergunta: 'Como sei que não é um relatório genérico?',
    resposta:
      'O relatório registra o commit auditado, lista os arquivos e rotas revisados e traz, para cada achado, o trecho exato com arquivo e linha. A seção de pontos fortes mostra o que foi verificado e está correto. Tudo é reproduzível no seu repositório.',
  },
  {
    pergunta: 'E se não houver achado crítico?',
    resposta:
      'O relatório diz isso com a cobertura demonstrada. Não inventamos achado para justificar o valor — a evidência de cobertura é o entregável.',
  },
  {
    pergunta: 'Vocês assinam NDA?',
    resposta:
      'Sim. Também exigimos autorização escrita antes de qualquer análise e não executamos teste ativo em produção.',
  },
  {
    pergunta: 'Quanto tempo leva?',
    resposta:
      'Depende do tamanho do repositório e do escopo. O prazo é fechado na proposta, com marcos — não por hora.',
  },
  {
    pergunta: 'O relatório serve para auditoria ou cliente corporativo?',
    resposta:
      'Foi desenhado para isso: evidência reproduzível, severidade justificada e correção sugerida. Não substitui certificação formal.',
  },
  {
    pergunta: 'E se a categoria não se aplicar?',
    resposta:
      'Dizemos isso explicitamente no relatório. Projeto sem frontend não recebe achado de XSS forçado, por exemplo.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Auditoria de segurança de aplicações e IA',
  description:
    'Auditoria de código em cinco categorias: isolamento de dados, permissão no servidor, IDOR, segredos expostos e XSS. Relatório em PDF com evidência linha a linha e issues prontas.',
  areaServed: 'BR',
  serviceType: 'Auditoria de segurança de aplicações',
  mainEntityOfPage: 'https://yanramos1.github.io/negocios-ia/servicos/',
};
---

<Base
  title="Auditoria de segurança de aplicações e IA"
  description="Auditoria de código em cinco categorias: isolamento de dados, permissão no servidor, IDOR, segredos expostos e XSS. Relatório em PDF com evidência linha a linha e issues prontas."
  ogImage="og/servicos.png"
>
  <h1>Auditoria de segurança de aplicações e IA</h1>
  <p class="lead">
    Cinco classes de falha que derrubam produto: dados sem isolamento, permissão só no
    navegador, IDOR, segredo exposto e HTML sem tratamento. Auditoria no código real, com
    evidência linha a linha e issues prontas para o time corrigir.
  </p>

  <ul class="selos">
    {selos.map((selo) => <li class="selo">{selo}</li>)}
  </ul>

  <p>
    <a class="botao" href={url('auditoria/relatorio-exemplo.pdf')} download>
      Ver relatório de exemplo (PDF)
    </a>
  </p>
  <Contato />

  <h2>Amostra do relatório</h2>
  <div class="card">
    <p class="aviso-legal">Trecho do relatório de exemplo — dados fictícios, para mostrar o formato.</p>
    <p><span class="chip chip-critica">CRÍTICA</span> <strong>IDOR</strong> · <code>src/routes/invoices.js:22</code></p>
    <pre class="codigo-amostra"><code>const invoice = await db('invoices').where(&#123; id: req.params.id &#125;).first();</code></pre>
    <p>
      A busca usa apenas o ID do path. Não há verificação de posse nem filtro por tenant, então
      trocar o número sequencial expõe faturas alheias. Correção: filtrar por tenant e dono na
      consulta e retornar 404 em vez de 403.
    </p>
  </div>

  <h2>O que é verificado</h2>
  <ul class="lista-ferramentas">
    {categorias.map((categoria) => (
      <li>
        <strong>{categoria.titulo}</strong>
        <p>{categoria.texto}</p>
      </li>
    ))}
  </ul>

  <h2>O que você recebe</h2>
  <ul class="lista-ferramentas">
    {entregaveis.map(([titulo, texto]) => (
      <li>
        <strong>{titulo}</strong>
        <p>{texto}</p>
      </li>
    ))}
  </ul>

  <h2>Como o trabalho é verificável</h2>
  <ul>
    <li><strong>Commit registrado.</strong> O relatório aponta o hash auditado — você sabe exatamente qual código foi lido.</li>
    <li><strong>Cobertura declarada.</strong> Arquivos e rotas revisados aparecem listados, com a seção de pontos fortes.</li>
    <li><strong>Achado reproduzível.</strong> Cada item tem arquivo, linha, trecho e caminho de exploração.</li>
    <li><strong>Zero achado inventado.</strong> Sem problema relevante, o relatório diz isso e mostra a cobertura.</li>
  </ul>

  <h2>Metodologia e referências</h2>
  <p>
    As categorias são mapeadas para a stack detectada e se apoiam em referências públicas — não
    em critério próprio inventado.
  </p>
  <table class="tabela">
    <thead><tr><th>Referência</th><th>Uso na auditoria</th></tr></thead>
    <tbody>
      {referencias.map(([nome, uso, link]) => (
        <tr>
          <td><a href={link} rel="noopener">{nome}</a></td>
          <td>{uso}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Como funciona</h2>
  <ul class="lista-ferramentas">
    {passos.map(([titulo, texto], indice) => (
      <li>
        <strong>{indice + 1}. {titulo}</strong>
        <p>{texto}</p>
      </li>
    ))}
  </ul>

  {
    autor.nome && (
      <section>
        <h2>Quem audita</h2>
        <p><strong>{autor.nome}</strong>{autor.cargo ? ` — ${autor.cargo}` : ''}</p>
        {autor.bio && <p>{autor.bio}</p>}
        <p>
          {autor.github && <a href={autor.github} rel="noopener">GitHub</a>}
          {autor.github && autor.linkedin && ' · '}
          {autor.linkedin && <a href={autor.linkedin} rel="noopener">LinkedIn</a>}
        </p>
      </section>
    )
  }

  {
    prova.autorizacao !== 'nao' && prova.cliente && prova.resultado && (
      <section>
        <h2>Resultado em cliente</h2>
        <p>
          <strong>{prova.cliente}</strong>
          {prova.setor ? ` — ${prova.setor}` : ''}
        </p>
        <p>{prova.resultado}</p>
        <p class="aviso-legal">
          {prova.autorizacao === 'anonimo'
            ? 'Cliente citado de forma anonimizada, com autorização para descrever o trabalho.'
            : 'Case citado com autorização do cliente.'}
        </p>
      </section>
    )
  }

  <h2>Limites e ética</h2>
  <ul>
    <li><strong>Autorização escrita</strong> antes de qualquer análise.</li>
    <li><strong>Nenhum teste ativo em produção</strong> — análise de código e configuração.</li>
    <li><strong>Achado crítico comunicado em 24h</strong>, antes do relatório final.</li>
    <li><strong>Dado do cliente não sai do ambiente acordado</strong> e não é usado como portfólio sem autorização.</li>
    <li><strong>Sem promessa de nota</strong>: entregamos evidência, não selo de segurança.</li>
  </ul>

  <h2>Escopo e investimento</h2>
  <p>
    Auditoria de segurança de IA e aplicações: <strong>R$ 18.000 a R$ 45.000</strong>, com
    escopo fechado e relatório em PDF mais issues. Para evolução contínua, existe o modelo de
    retainer mensal.
  </p>
  <p class="aviso-legal">
    O relatório de exemplo usa dados fictícios para demonstrar o formato — não é auditoria de
    cliente real.
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <details>
        <summary>{item.pergunta}</summary>
        <p>{item.resposta}</p>
      </details>
    ))}
  </section>

  <Contato />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
